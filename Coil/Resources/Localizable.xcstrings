    "Your clean streak starts again tomorrow. Slips are part of the process.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серия начнётся заново завтра. Срывы — часть пути."
          }
        }
      }
    },
    "Your habits are stored only on this device. Export a backup from time to time to keep them safe.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привычки хранятся только на этом устройстве. Время от времени делайте резервную копию, чтобы их не потерять."
          }
        }
      }
    },
    "Your habits sync across your devices through your private iCloud account.": {
